{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile details synchronized from Google authentication",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "financialAccount": {
      "title": "FinancialAccount",
      "description": "User financial account or wallet bucket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "nameAr": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["cash", "bank", "card", "savings"] },
        "balance": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "color": { "type": "string", "maxLength": 32 },
        "icon": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "userId", "name", "nameAr", "type", "balance", "currency"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial income, expense, or transfer transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "accountId": { "type": "string", "maxLength": 64 },
        "toAccountId": { "type": "string", "maxLength": 64 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "dateTime": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "amount", "currency", "accountId", "date", "description"]
    },
    "category": {
      "title": "Category",
      "description": "Spending or income category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "nameAr": { "type": "string", "maxLength": 64 },
        "icon": { "type": "string", "maxLength": 32 },
        "color": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "enum": ["income", "expense"] }
      },
      "required": ["id", "userId", "name", "nameAr", "type"]
    },
    "userSubscription": {
      "title": "UserSubscription",
      "description": "Server-owned subscription and trial status",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["trial", "paid", "expired"] },
        "trialStartedAt": { "type": "string", "maxLength": 64 },
        "trialExpiresAt": { "type": "string", "maxLength": 64 },
        "totalTrialDays": { "type": "number" },
        "affiliateCode": { "type": ["string", "null"], "maxLength": 32 },
        "hasAppliedAffiliateCode": { "type": "boolean" },
        "isPaid": { "type": "boolean" },
        "monthlyPriceEgp": { "type": ["number", "null"] },
        "dailyAiEntryLimit": { "type": "number" },
        "dailyAiInquiryLimit": { "type": "number" },
        "maxHistoricalQueryDays": { "type": "number" }
      },
      "required": ["status", "trialStartedAt", "trialExpiresAt", "totalTrialDays", "hasAppliedAffiliateCode", "isPaid"]
    },
    "affiliateCode": {
      "title": "AffiliateCode",
      "description": "Protected marketer-code configuration",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "active": { "type": "boolean" },
        "totalTrialDays": { "type": "number" },
        "monthlyPriceEgp": { "type": ["number", "null"] },
        "maxRedemptions": { "type": ["number", "null"] },
        "redemptionCount": { "type": "number" },
        "validFrom": { "type": ["string", "null"], "maxLength": 64 },
        "validUntil": { "type": ["string", "null"], "maxLength": 64 }
      },
      "required": ["code", "active", "totalTrialDays", "redemptionCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile details"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "financialAccount",
      "description": "Financial accounts belonging to the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Transactions belonging to the user"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "category",
      "description": "Custom or synchronized categories belonging to the user"
    },
    "/users/{userId}/billing/subscription": {
      "schema": "userSubscription",
      "description": "Server-owned user subscription status"
    },
    "/affiliateCodes/{codeId}": {
      "schema": "affiliateCode",
      "description": "Protected marketer-code settings and counters"
    }
  }
}
