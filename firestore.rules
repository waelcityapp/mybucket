rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: no listing of all users
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Financial Accounts Subcollection
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(accountId);
        allow delete: if isOwner(userId);
      }

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId);
        allow delete: if isOwner(userId);
      }

      // Categories Subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(categoryId);
        allow delete: if isOwner(userId);
      }

      // Subscription and billing data is server-owned.
      // The user may read their own status but all writes go through authenticated server endpoints.
      match /billing/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Marketer-code configuration and redemption logs are never exposed to clients.
    match /affiliateCodes/{codeId} {
      allow read, write: if false;

      match /redemptions/{userId} {
        allow read, write: if false;
      }
    }
  }
}
