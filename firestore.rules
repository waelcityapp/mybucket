rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate stored text even when writes bypass the browser interface.
    function shortText(data, key, maxLength) {
      let value = data.get(key, '');
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validAccountText(data) {
      return shortText(data, 'name', 40) && shortText(data, 'nameAr', 40);
    }

    function validCategoryText(data) {
      return shortText(data, 'name', 40) && shortText(data, 'nameAr', 40);
    }

    function validTransactionText(data) {
      return shortText(data, 'description', 150);
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: no listing of all users
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Financial Accounts Subcollection
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(accountId) && validAccountText(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && validTransactionText(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Categories Subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(categoryId) && validCategoryText(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Subscription and billing data is server-owned.
      // The user may read their own status but all writes go through authenticated server endpoints.
      match /billing/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Marketer-code configuration and redemption logs are never exposed to clients.
    match /affiliateCodes/{codeId} {
      allow read, write: if false;

      match /redemptions/{userId} {
        allow read, write: if false;
      }
    }
  }
}
