{
  "crons": [{ "path": "/api/gateway", "schedule": "0 2 * * *" }],
  "headers": [
    {
      "source": "/offers/ad/:id(demo-[a-z0-9-]+)",
      "crons": [{ "path": "/api/gateway", "schedule": "0 2 * * *" }],
  "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
