{
  "crons": [
    {
      "path": "/api/gateway",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/offers/ad/:id(demo-[a-z0-9-]+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/gateway.ts": {
      "includeFiles": "public/{icons/mybucket-512.png,demo-ads/*.jpg}"
    }
  },
  "rewrites": [
    {
      "source": "/s/en/:id/i",
      "destination": "/api/gateway?offerShare=:id&lang=en&format=image&compact=1"
    },
    {
      "source": "/s/en/:id",
      "destination": "/api/gateway?offerShare=:id&lang=en&compact=1"
    },
    {
      "source": "/s/:id/i",
      "destination": "/api/gateway?offerShare=:id&lang=ar&format=image&compact=1"
    },
    {
      "source": "/s/:id",
      "destination": "/api/gateway?offerShare=:id&lang=ar&compact=1"
    },
    {
      "source": "/offers/share/:lang/:id/image",
      "destination": "/api/gateway?offerShare=:id&lang=:lang&format=image"
    },
    {
      "source": "/offers/share/:lang/:id",
      "destination": "/api/gateway?offerShare=:id&lang=:lang"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
